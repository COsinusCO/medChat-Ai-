# TrueGis backend host. Defaults to the dev gateway when unset.
# The app derives both bases from it: <host>/v1 (gateway) and <host>/homepage/v1 (home cards).
EXPO_PUBLIC_API_HOST=https://dev.admin13.uz

# Google Maps SDK for Android key (Google Cloud console -> Credentials).
# Injected into the manifest by app.config.ts, so run `npx expo prebuild -p android --clean`
# after setting it. Unset: Android hides the map and shows results as a list only.
GOOGLE_MAPS_API_KEY=
